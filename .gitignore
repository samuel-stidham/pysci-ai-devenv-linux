# devenv build state and generated flake
.devenv/
.devenv.flake.nix

# python virtualenv (devenv creates one under .devenv state, but a manual
# .venv from uv or poetry can also land here)
.venv/

# direnv cache
.direnv/

# python bytecode
__pycache__/
*.py[cod]
*$py.class

# Environment files
.env
.envrc

# Jupyter Lab
.ipynb_checkpoints/
.virtual_documents/
*.ipynb

# packaging artifacts (build, twine)
build/
dist/
*.egg-info/
.eggs/
*.egg
MANIFEST
pip-log.txt
pip-delete-this-directory.txt

# compiled extensions built in-tree (cython, pybind11)
*.so
cython_debug/

# test and coverage caches (pytest, pytest-cov)
.pytest_cache/
.tox/
.nox/
.hypothesis/
.coverage
.coverage.*
htmlcov/
coverage.xml

# linter and type checker caches (ruff, mypy)
.ruff_cache/
.mypy_cache/
.pyre/
.pytype/

# stray pyenv pin. devenv.nix owns the interpreter version, a
# .python-version file would only fight it.
.python-version
